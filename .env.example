# ==============================================================================
# Agent 63 – Data Analytics Agent: Environment Configuration Template
# ==============================================================================
# NOTE: This file is a template containing placeholder values only.
# Copy this file to .env and provide your deployment-specific values.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# College-Provided Database Credentials (Configured in Phase 1 & 2)
# Strictly use read-only credentials for analytical query execution
COLLEGE_DB_DRIVER=postgresql
COLLEGE_DB_HOST=
COLLEGE_DB_PORT=5432
COLLEGE_DB_NAME=academic_agent_platform
COLLEGE_DB_USER=
COLLEGE_DB_PASSWORD=
COLLEGE_DB_SSL_MODE=prefer
COLLEGE_DB_CONNECT_TIMEOUT=5
COLLEGE_DB_STATEMENT_TIMEOUT=5000
DATABASE_URL=
DATABASE_READONLY_URL=

# CORS Allowed Origins (JSON array or comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Schema Registry Path (Optional override; defaults to database/mappings/agent63_schema_registry.json)
SCHEMA_REGISTRY_PATH=

# Authentication & Security (Phase 5)
AUTH_ENABLED=true
# JWT_SECRET: Minimum 32 characters. Replace with a secure cryptographic key in deployment.
# In production, example/placeholder strings will be rejected at startup.
JWT_SECRET=replace-with-secure-32-byte-secret-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=agent63-auth
JWT_AUDIENCE=agent63-api

# Test Fixture Separation (Phase 5 Security)
# Strictly false in production. When false, test fixtures (test_principal, etc.) are never loaded.
ALLOW_TEST_FIXTURES=false


# LLM Orchestration Provider (Configured in Phase 6)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=

# Audit & Logging
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true
