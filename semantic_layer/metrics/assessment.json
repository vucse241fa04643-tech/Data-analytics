        "period_grain": "term"
      },
      "null_handling": {
        "missing_records": "NULL",
        "zero_denominator": "NULL if no students appeared"
      },
      "sensitivity": "INTERNAL_INSTITUTIONAL",
      "status": "APPROVED",
      "version": "1.0",
      "provenance": "assessment.v_course_performance view in schema_full.sql",
      "validation_notes": "Derived from assessment.course_result.total_marks."
    },
