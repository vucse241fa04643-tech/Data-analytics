{
  "domain": "assessment",
  "version": "1.0",
  "description": "Academic performance metrics covering course examination pass rates, mark averages, appeared candidates, and CIA scores.",
  "metrics": [
    {
      "metric_id": "assessment.course_pass_percentage",
      "canonical_name": "course_pass_percentage",
      "display_name": "Course Pass Percentage",
      "description": "Percentage of examined students who passed the course examination offering.",
      "domain": "assessment",
      "category": "academic_performance",
      "grain": "course_offering",
      "formula": "round(100.0 * count(*) FILTER (WHERE result_status = 'PASS') / nullif(count(*) FILTER (WHERE result_status <> 'ABSENT'), 0), 2)",
      "aggregation": "RATIO",
      "unit": "percentage",
      "numerator": "passed",
      "denominator": "students_appeared",
      "source_objects": [
        "assessment.v_course_performance"
      ],
      "source_columns": [
        "pass_pct",
        "passed",
        "students_appeared",
        "course_offering_id",
        "term_id",
        "department_id"
      ],
      "allowed_dimensions": [
        "dim.academic_year",
        "dim.term",
        "dim.department",
        "dim.course",
        "dim.course_offering",
        "dim.section"
      ],
      "allowed_filters": [
        "term_id",
        "course_offering_id",
        "department_id",
        "section_id"
      ],
      "time_semantics": {
        "time_dimension": "dim.term",
        "time_column": "term_id",
        "period_grain": "term"
      },
      "null_handling": {
        "missing_records": "NULL",
        "zero_denominator": "NULLIF(students_appeared, 0) yields NULL (prevents divide by zero when 0 students appeared)"
      },
      "sensitivity": "INTERNAL_INSTITUTIONAL",
      "status": "APPROVED",
      "version": "1.0",
      "provenance": "assessment.v_course_performance view in schema_full.sql",
      "validation_notes": "Directly matches authoritative institutional view calculation."
    },
    {
      "metric_id": "assessment.average_total_marks",
