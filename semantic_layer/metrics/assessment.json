      "domain": "assessment",
      "category": "academic_performance",
      "grain": "course_offering",
      "formula": "round(avg(total_marks), 2)",
      "aggregation": "AVG",
      "unit": "marks",
      "numerator": "sum(total_marks)",
      "denominator": "count(student_id)",
      "source_objects": [
        "assessment.v_course_performance"
      ],
      "source_columns": [
        "avg_total_marks",
        "course_offering_id",
        "term_id",
        "department_id"
