{
  "domain": "placement",
  "version": "1.0",
  "description": "Institutional career placement metrics covering verified student offers, compensation packages, corporate participation, and readiness scores.",
  "metrics": [
    {
      "metric_id": "placement.placed_students_count",
      "canonical_name": "placed_students_count",
      "display_name": "Placed Students Count",
      "description": "Count of unique graduating students who have received and accepted at least one verified employment offer.",
      "domain": "placement",
      "category": "career_outcomes",
      "grain": "batch",
      "formula": "count(DISTINCT student_id) FILTER (WHERE status IN ('ACCEPTED', 'JOINED', 'OFFERED'))",
      "aggregation": "COUNT_DISTINCT",
      "unit": "count",
      "numerator": "count(DISTINCT student_id)",
      "denominator": null,
      "source_objects": [
        "placement.offer"
      ],
      "source_columns": [
        "student_id",
        "status",
        "offer_date"
      ],
      "allowed_dimensions": [
        "dim.academic_year",
        "dim.department",
        "dim.programme",
        "dim.batch"
      ],
      "allowed_filters": [
        "status"
      ],
      "time_semantics": {
        "time_dimension": "dim.academic_year",
        "time_column": "offer_date",
        "period_grain": "academic_year"
      },
      "null_handling": {
        "missing_records": "0",
        "zero_denominator": null
      },
      "sensitivity": "INTERNAL_INSTITUTIONAL",
      "status": "APPROVED",
      "version": "1.0",
      "provenance": "placement.offer table in schema_full.sql",
      "validation_notes": "Distinguishes distinct placed students from total offer count to account for multi-offer recipients."
    },
    {
      "metric_id": "placement.total_offers_count",
      "canonical_name": "total_offers_count",
      "display_name": "Total Employment Offers Count",
      "description": "Aggregate count of all verified employment offers issued across participating recruitment companies.",
      "domain": "placement",
      "category": "career_outcomes",
      "grain": "batch",
      "formula": "count(offer_id)",
      "aggregation": "COUNT",
      "unit": "count",
      "numerator": "count(offer_id)",
      "denominator": null,
      "source_objects": [
        "placement.offer"
      ],
      "source_columns": [
        "offer_id",
        "status",
        "offer_date"
      ],
      "allowed_dimensions": [
        "dim.academic_year",
        "dim.department",
        "dim.programme",
        "dim.batch"
      ],
      "allowed_filters": [
        "status"
      ],
      "time_semantics": {
        "time_dimension": "dim.academic_year",
        "time_column": "offer_date",
        "period_grain": "academic_year"
      },
      "null_handling": {
        "missing_records": "0",
        "zero_denominator": null
      },
      "sensitivity": "INTERNAL_INSTITUTIONAL",
      "status": "APPROVED",
      "version": "1.0",
      "provenance": "placement.offer table in schema_full.sql",
      "validation_notes": "Includes single and multi-offers."
    },
    {
      "metric_id": "placement.average_ctc",
      "canonical_name": "average_ctc",
      "display_name": "Average Placement CTC (Annual)",
      "description": "Mean annual Cost to Company (CTC) compensation package for verified placement offers.",
      "domain": "placement",
      "category": "compensation_analytics",
      "grain": "batch",
      "formula": "round(avg(ctc), 2)",
      "aggregation": "AVG",
      "unit": "inr_lakhs_per_annum",
      "numerator": "sum(ctc)",
      "denominator": "count(offer_id)",
      "source_objects": [
        "placement.offer"
      ],
      "source_columns": [
        "ctc",
        "status",
        "offer_date"
      ],
      "allowed_dimensions": [
        "dim.academic_year",
