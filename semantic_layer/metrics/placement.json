        "dim.programme",
        "dim.batch"
      ],
      "allowed_filters": [
        "status"
      ],
      "time_semantics": {
        "time_dimension": "dim.academic_year",
        "time_column": "offer_date",
        "period_grain": "academic_year"
      },
      "null_handling": {
        "missing_records": "NULL",
        "zero_denominator": "NULL if no offers"
      },
      "sensitivity": "INTERNAL_INSTITUTIONAL",
      "status": "APPROVED",
      "version": "1.0",
      "provenance": "placement.offer.ctc in schema_full.sql",
      "validation_notes": "Compensation metric derived from placement.offer."
    },
    {
      "metric_id": "placement.highest_ctc",
      "canonical_name": "highest_ctc",
      "display_name": "Highest Placement CTC (Annual)",
      "description": "Maximum annual CTC compensation offer secured by any student in the cohort.",
      "domain": "placement",
      "category": "compensation_analytics",
      "grain": "batch",
      "formula": "max(ctc)",
      "aggregation": "MAX",
